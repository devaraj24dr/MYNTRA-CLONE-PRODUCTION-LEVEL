PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/myntra

# ─── Notification Rate Limiting ───────────────────────────────────────────────
# Max promotional notifications per user per window (default: 5)
NOTIFICATION_LIMIT_MAX_PROMOTIONS=5
# Window size in milliseconds (default: 3600000 = 1 hour)
NOTIFICATION_LIMIT_WINDOW_MS=3600000

# ─── Queue Worker ──────────────────────────────────────────────────────────────
# Max jobs processed per polling tick (default: 5)
QUEUE_MAX_JOBS_PER_TICK=5
# Worker polling interval in ms (default: 5000 = 5 seconds)
QUEUE_POLL_INTERVAL_MS=5000
# Max lock duration before a job is considered stuck and recovered (default: 60000 = 60s)
QUEUE_LOCK_TIMEOUT_MS=60000

# ─── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (use * for all, e.g. in development)
ALLOWED_ORIGINS=*

# ─── Authentication ────────────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_here
